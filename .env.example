NODE_ENV=development
PORT=3000

# Public
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=chekka
REDIS_URI=redis://127.0.0.1:6379

# Auth
JWT_ACCESS_TOKEN_SECRET=replace_me_with_a_long_random_secret_string
JWT_REFRESH_TOKEN_SECRET=replace_me_with_a_long_random_secret_string
COOKIE_DOMAIN=

# AWS S3 (commented out in favor of ImageKit storage)
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_ACCESS_KEY=
# CLOUDFRONT_CDN_URL=

# ImageKit Storage (leave empty to use mock:// URLs for local dev)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Paystack (use sk_test_... in development/test mode)
PAYSTACK_SECRET_KEY=
PAYSTACK_API_BASE_URL=https://api.paystack.co

# Set to 1 in e2e to bypass rate limiting
DISABLE_RATE_LIMIT=

# Seed
SEED_DEFAULT_PASSWORD=password123
